#!/usr/bin/env bash

docker rm -f ldap || echo "ldap was not running"
docker run --detach \
 --net rabbitmq_net \
 --env LDAP_ORGANISATION="Authentication and Tags" \
 --env LDAP_DOMAIN="example.com" \
 --env LDAP_ADMIN_PASSWORD="admin" \
 -p 389:389 \
 -p 636:636 \
 --name ldap \
 osixia/openldap:1.2.1
